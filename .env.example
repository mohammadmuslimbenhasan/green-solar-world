# Copy to .env.local for local development.
# These are PUBLIC keys — safe to expose to the browser (RLS protects the data).
# Without them, the site builds and runs perfectly from the bundled seed data,
# and the contact/order forms fall back to mailto:/tel:.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: canonical URL used in metadata, sitemap and robots.
# NEXT_PUBLIC_SITE_URL=https://gsworld.ca
